{
  "name": "tako-webview",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "bundle": "esbuild src/main.ts --bundle --format=iife --target=es2022 --legal-comments=eof --minify-whitespace --minify-syntax --outfile=../build/generated/webview/webview/app.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}

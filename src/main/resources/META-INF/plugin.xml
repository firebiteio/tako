<idea-plugin>
  <id>io.firebite.tako</id>
  <name>Tako: AI Agent Chat</name>
  <vendor url="https://firebite.io">Firebite</vendor>
  <description><![CDATA[
    <p>Chat with Claude Code, OpenAI Codex, Gemini CLI, OpenCode or any Agent Client Protocol (ACP) agent
    in a JetBrains IDE tool window. Tako runs the agent CLI you already have installed. You review its edits in the IDE diff viewer.</p>
    <ul>
      <li>Answers stream in, tool calls show as cards, and permission prompts open the edit in the diff viewer</li>
      <li>After each turn, open a diff of every file the agent touched. Comment on lines and send the comments back</li>
      <li>Run several threads per project, each with its own agent, model, mode and effort</li>
      <li>Rewind a thread to an earlier prompt, with or without restoring the files</li>
      <li>Commit, push and open a GitHub pull request or GitLab merge request. The agent writes the message</li>
      <li>Watch a pull request. The agent wakes up when checks fail, a review comes in or it gets merged</li>
      <li>Send one prompt to several agents or models at once, each in its own git worktree, and keep the best result</li>
      <li>Let agents start and steer other threads. <code>/orchestrate</code> splits a task across them</li>
      <li>Attach the editor selection, files, images or inspection results. Resume sessions you started in the CLI</li>
    </ul>
    <p>You need at least one agent CLI, such as <code>claude</code>, <code>codex</code> or <code>gemini</code>,
    on your <code>PATH</code> or set in Settings | Tools | Tako.</p>
  ]]></description>

  <resource-bundle>messages.TakoBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.compose</depends>
  <depends optional="true" config-file="tako-terminal.xml">org.jetbrains.plugins.terminal</depends>
  <dependencies>
    <module name="intellij.platform.compose.markdown"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Tako" anchor="right" secondary="false" icon="/icons/tako.svg"
                factoryClass="io.firebite.tako.chat.ChatToolWindowFactory"/>
    <applicationConfigurable parentId="tools" id="io.firebite.tako.settings" key="configurable.tako"
                             instance="io.firebite.tako.settings.ChatSettingsConfigurable"/>
    <applicationConfigurable parentId="io.firebite.tako.settings" id="io.firebite.tako.settings.claude"
                             key="configurable.claude" instance="io.firebite.tako.settings.ClaudeCodeConfigurable"/>
    <applicationConfigurable parentId="io.firebite.tako.settings" id="io.firebite.tako.settings.codex"
                             key="configurable.codex" instance="io.firebite.tako.settings.CodexConfigurable"/>
    <applicationConfigurable parentId="io.firebite.tako.settings" id="io.firebite.tako.settings.acp"
                             key="configurable.acp" instance="io.firebite.tako.settings.AcpAgentsConfigurable"/>
    <notificationGroup id="Tako" displayType="BALLOON" key="notification.group.tako"/>
    <statusBarWidgetFactory id="Tako.Status" implementation="io.firebite.tako.ide.status.TakoStatusWidgetFactory"/>
    <actionPromoter implementation="io.firebite.tako.ui.view.StashActionPromoter"/>
    <postStartupActivity implementation="io.firebite.tako.chat.WatchStartup"/>
  </extensions>

  <applicationListeners>
    <listener class="io.firebite.tako.chat.QueueStashOnClose" topic="com.intellij.openapi.project.ProjectCloseListener"/>
  </applicationListeners>

  <actions>
    <action id="Tako.NewChat" class="io.firebite.tako.ide.actions.NewChatAction" icon="AllIcons.General.Add">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <group id="Tako.ContextGroup" popup="true" icon="/icons/tako.svg">
      <action id="Tako.AddToChat" class="io.firebite.tako.ide.actions.AddToChatAction">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift K"/>
        <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
      </action>
      <action id="Tako.ReviewComment" class="io.firebite.tako.ide.actions.ReviewCommentAction" icon="/icons/tako.svg">
        <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
      </action>
      <action id="Tako.FixProblems" class="io.firebite.tako.ide.actions.FixProblemsAction"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </group>
    <action id="Tako.StashPrompt" class="io.firebite.tako.ui.view.StashAction">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl S"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta S" replace-all="true"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta S" replace-all="true"/>
      <keyboard-shortcut keymap="Emacs" first-keystroke="ctrl S" remove="true"/>
    </action>
  </actions>
</idea-plugin>
